{
  "name": "tju-quiz-hub-site",
  "version": "0.1.0",
  "description": "天津大学多科目客观题刷题站",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/WhatYearIsNow/TJU-Quiz-Hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhatYearIsNow/TJU-Quiz-Hub.git"
  },
  "bugs": {
    "url": "https://github.com/WhatYearIsNow/TJU-Quiz-Hub/issues"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:static": "node tooling/sync-static-assets.mjs",
    "sync:check": "node tooling/sync-static-assets.mjs --check",
    "predev": "npm run sync:static",
    "dev": "vinext dev",
    "prebuild": "npm run sync:static",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test",
    "check": "npm run sync:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
