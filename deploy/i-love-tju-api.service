[Unit]
Description=I Love TJU API (sync / annotations / AI check)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/exam/.local/current
Environment=ILOVETJU_CONFIG=/opt/exam/config.json
Environment=ILOVETJU_DATA_DIR=/opt/exam/data
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/exam/.local/current/server.py --host 127.0.0.1 --port 8901 --web-dir /opt/exam/.local/current/web
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
