# Replace example.com and the project path for your installation.
example.com {
    encode gzip

    @backend path /sync /sync/* /api/* /health
    handle @backend {
        reverse_proxy 127.0.0.1:8901
    }

    @downloads path /*.apk /*.idsig /dl /dl/*
    handle @downloads {
        root * /opt/exam/.local/public
        file_server
    }

    handle {
        root * /opt/exam/.local/current/web
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}
